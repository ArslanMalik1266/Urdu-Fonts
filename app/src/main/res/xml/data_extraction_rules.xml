<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Subscription status and the login session must come from the server,
     never from a cloud backup or a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/entitlement_preferences.preferences_pb" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/entitlement_preferences.preferences_pb" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
