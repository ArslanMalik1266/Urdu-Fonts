<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
     Subscription status and the login session must come from the server, never from a restored copy. -->
<full-backup-content>
    <exclude domain="file" path="datastore/entitlement_preferences.preferences_pb" />
    <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
</full-backup-content>
