platform :ios, '16.0'
use_frameworks! :linkage => :static

target 'iosApp' do
  # Google sign-in (account picker → ID token for the IAP backend)
  pod 'GoogleSignIn', '~> 8.0'

  # Push: FCM tokens on top of APNs, the same push backend as Android
  pod 'FirebaseCore'
  pod 'FirebaseMessaging'

  # WebsCare Ads for iOS. TODO: replace with the exact pod name / source your team publishes, e.g.
